POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123
POSTGRES_DB=products_db

# Альтернатива: можно вместо переменных выше задать готовый DSN:
# POSTGRES_DSN=host=localhost port=5432 user=postgres password=123 dbname=products_db sslmode=disable


# --- MongoDB ---
# Полная строка подключения (если задана, остальные MONGO_* игнорируются)
# MONGO_URI=mongodb://user:password@localhost:27017/?authSource=admin

# Или по отдельным параметрам:
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=products_mongo

